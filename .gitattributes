# ---------- Défaut : texte avec normalisation LF ----------
* text=auto eol=lf

# ---------- Code source (LF strict) ----------
*.py    text eol=lf
*.pyi   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.css   text eol=lf
*.scss  text eol=lf
*.html  text eol=lf
*.sql   text eol=lf
*.sh    text eol=lf

# ---------- Configuration ----------
*.toml      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.json      text eol=lf
*.jsonc     text eol=lf
*.ini       text eol=lf
*.cfg       text eol=lf
*.conf      text eol=lf
.editorconfig text eol=lf
.gitignore    text eol=lf
.gitattributes text eol=lf
.dockerignore text eol=lf
.env.example  text eol=lf
Dockerfile    text eol=lf
*.dockerfile  text eol=lf

# ---------- Documentation ----------
*.md text eol=lf
*.markdown text eol=lf
*.txt text eol=lf

# ---------- Scripts Windows (si jamais nécessaires) ----------
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# ---------- Binaires (pas de diff, pas de normalisation) ----------
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.svg  text eol=lf
*.pdf  binary
*.zip  binary
*.gz   binary
*.tar  binary
*.tgz  binary
*.bz2  binary
*.7z   binary
*.rar  binary
*.xlsx binary
*.xls  binary
*.docx binary
*.doc  binary
*.pptx binary
*.ppt  binary
*.parquet binary
*.feather binary
*.npy  binary
*.npz  binary

# ---------- GitHub linguist : forcer la classification ----------
specs-*.md   linguist-documentation
v0-status.md linguist-documentation
*.md         linguist-detectable=true
