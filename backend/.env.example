# Connexion Postgres locale (Docker Compose)
DATABASE_URL="postgresql://ro_user:ro_dev_password@localhost:5432/ro_dev?schema=public"

# Application
PORT=3000
NODE_ENV=development

# Logging
LOG_LEVEL=debug

# Phase 4 J5 — bridge HTTP synchrone vers le service Python preflight
# (poc-scheduler/scripts/preflight_service.py)
PREFLIGHT_SERVICE_URL=http://localhost:8001

# Phase 5 — origins CORS autorisees (separator virgule). Defaut = frontend Next.js local.
CORS_ORIGIN=http://localhost:3001
